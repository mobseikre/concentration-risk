    <!-- ═══════════════════════════════════════════
         SCREEN 5 — AUTOMATIC PROCESSING (System)
         SRS 5.5 / FR-5 — concentration calculations
         ═══════════════════════════════════════════ -->
    <bpmn2:scriptTask id="_Screen5" name="Screen 5 - Automatic Calculation" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Screen 5 - Automatic Calculation]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SF_GW_Checker_Approve</bpmn2:incoming>
      <bpmn2:outgoing>_SF_S5_Merge6</bpmn2:outgoing>
      <bpmn2:script><![CDATA[
// ═══ AUTOMATIC CALCULATION ENGINE (SRS 5.5) ═══
// For each dimension (Company Field / Geographical / Credit type):
//    relative weight = balance / total * 100
//    weight squared   = relative weight * relative weight
// Hidden rows and adjustments from Screen 3 are fully incorporated.

java.util.List rows = (java.util.List) kcontext.getVariable("adjustedData");
String reqType = (String) kcontext.getVariable("requirementType");
Double limit = (Double) kcontext.getVariable("regulatoryLimit");
if (limit == null) { limit = 25.0; }

double total = 0.0;
for (Object o : rows) {
    com.myspace.concentration_risk.ConcentrationRow r = (com.myspace.concentration_risk.ConcentrationRow) o;
    if (r == null || Boolean.TRUE.equals(r.getHidden())) { continue; }
    double v = (r.getAdjustedValue() != null ? r.getAdjustedValue() : (r.getBalanceDue() != null ? r.getBalanceDue() : 0.0));
    total += v;
}
if (total <= 0.0) { total = 1.0; }

java.util.LinkedHashMap sectors = new java.util.LinkedHashMap();
java.util.LinkedHashMap geos = new java.util.LinkedHashMap();
java.util.LinkedHashMap credits = new java.util.LinkedHashMap();
for (Object o : rows) {
    com.myspace.concentration_risk.ConcentrationRow r = (com.myspace.concentration_risk.ConcentrationRow) o;
    if (r == null || Boolean.TRUE.equals(r.getHidden())) { continue; }
    double v = (r.getAdjustedValue() != null ? r.getAdjustedValue() : (r.getBalanceDue() != null ? r.getBalanceDue() : 0.0));
    String fk = r.getCompanyField() != null ? r.getCompanyField() : "N/A";
    String gk = r.getGeographicalConcentration() != null ? r.getGeographicalConcentration() : "N/A";
    String ck = r.getCreditType() != null ? r.getCreditType() : "N/A";
    Double fs = (Double) sectors.get(fk); sectors.put(fk, new Double((fs == null ? 0.0 : fs.doubleValue()) + v));
    Double gs = (Double) geos.get(gk); geos.put(gk, new Double((gs == null ? 0.0 : gs.doubleValue()) + v));
    Double cs = (Double) credits.get(ck); credits.put(ck, new Double((cs == null ? 0.0 : cs.doubleValue()) + v));
}

java.util.List sectorResults = new java.util.ArrayList();
java.util.List geoResults = new java.util.ArrayList();
java.util.List creditResults = new java.util.ArrayList();
for (Object e : sectors.entrySet()) {
    java.util.Map.Entry en = (java.util.Map.Entry) e;
    Double bal = (Double) en.getValue();
    com.myspace.concentration_risk.DimensionResult d = new com.myspace.concentration_risk.DimensionResult();
    d.setName((String) en.getKey());
    d.setBalance(bal);
    double rel = bal.doubleValue() / total * 100.0;
    d.setRelativeWeight(Math.round(rel * 100.0) / 100.0);
    d.setWeightSquared(Math.round(d.getRelativeWeight() * d.getRelativeWeight() * 100.0) / 100.0);
    sectorResults.add(d);
}
for (Object e : geos.entrySet()) {
    java.util.Map.Entry en = (java.util.Map.Entry) e;
    Double bal = (Double) en.getValue();
    com.myspace.concentration_risk.DimensionResult d = new com.myspace.concentration_risk.DimensionResult();
    d.setName((String) en.getKey());
    d.setBalance(bal);
    double rel = bal.doubleValue() / total * 100.0;
    d.setRelativeWeight(Math.round(rel * 100.0) / 100.0);
    d.setWeightSquared(Math.round(d.getRelativeWeight() * d.getRelativeWeight() * 100.0) / 100.0);
    geoResults.add(d);
}
for (Object e : credits.entrySet()) {
    java.util.Map.Entry en = (java.util.Map.Entry) e;
    Double bal = (Double) en.getValue();
    com.myspace.concentration_risk.DimensionResult d = new com.myspace.concentration_risk.DimensionResult();
    d.setName((String) en.getKey());
    d.setBalance(bal);
    double rel = bal.doubleValue() / total * 100.0;
    d.setRelativeWeight(Math.round(rel * 100.0) / 100.0);
    d.setWeightSquared(Math.round(d.getRelativeWeight() * d.getRelativeWeight() * 100.0) / 100.0);
    creditResults.add(d);
}

double hhiS = 0.0;
double hhiG = 0.0;
double hhiC = 0.0;
double maxS = 0.0;
for (Object o : sectorResults) {
    com.myspace.concentration_risk.DimensionResult d = (com.myspace.concentration_risk.DimensionResult) o;
    hhiS += d.getWeightSquared();
    if (d.getRelativeWeight() != null && d.getRelativeWeight() > maxS) { maxS = d.getRelativeWeight(); }
}
for (Object o : geoResults) {
    com.myspace.concentration_risk.DimensionResult d = (com.myspace.concentration_risk.DimensionResult) o;
    hhiG += d.getWeightSquared();
}
for (Object o : creditResults) {
    com.myspace.concentration_risk.DimensionResult d = (com.myspace.concentration_risk.DimensionResult) o;
    hhiC += d.getWeightSquared();
}

com.myspace.concentration_risk.CalculatedResults res = new com.myspace.concentration_risk.CalculatedResults();
res.setRequirementType(reqType);
res.setReportingPeriod("Q4-2025");
res.setTotalBalance(total);
res.setSectorResults(sectorResults);
res.setGeographicResults(geoResults);
res.setCreditTypeResults(creditResults);
res.setHhiSector(Math.round(hhiS * 100.0) / 100.0);
res.setHhiGeographic(Math.round(hhiG * 100.0) / 100.0);
res.setHhiCreditType(Math.round(hhiC * 100.0) / 100.0);
res.setMaxConcentration(Math.round(maxS * 100.0) / 100.0);
res.setRegulatoryLimit(limit);
res.setStatus(res.getMaxConcentration() > limit ? "NON-COMPLIANT" : "COMPLIANT");
res.setCalculationDate(new java.util.Date().toString());
res.setExcelFilePath("/reports/" + reqType.replace(" ", "_") + "_Q4_2025.xlsx");

kcontext.setVariable("calculatedResults", res);
kcontext.setVariable("excelFilePath", res.getExcelFilePath());
kcontext.setVariable("reportStatus", "CALCULATED");
System.out.println("Calculation done: " + res);
      ]]></bpmn2:script>
    </bpmn2:scriptTask>

