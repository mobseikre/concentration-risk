    <bpmn2:sequenceFlow id="_SF_GW_Checker_Approve" name="Approved" sourceRef="_GW_Checker" targetRef="_Screen5">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "Approved".equals(checkerDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_SF_GW_Checker_Merge3" name="Return to Sender" sourceRef="_GW_Checker" targetRef="_GW_Merge3">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "ReturnToSender".equals(checkerDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_SF_S5_Merge6" sourceRef="_Screen5" targetRef="_GW_Merge6"/>
    <bpmn2:sequenceFlow id="_SF_Merge6_S6" sourceRef="_GW_Merge6" targetRef="_Screen6"/>
    <bpmn2:sequenceFlow id="_SF_S6_S7" sourceRef="_Screen6" targetRef="_Screen7"/>
    <bpmn2:sequenceFlow id="_SF_S7_GW_FinalChecker" sourceRef="_Screen7" targetRef="_GW_FinalChecker"/>
    <bpmn2:sequenceFlow id="_SF_GW_FinalChecker_Approve" name="Approved" sourceRef="_GW_FinalChecker" targetRef="_Screen8">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "Approved".equals(finalCheckerDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_SF_GW_FinalChecker_Merge6" name="Return to Sender" sourceRef="_GW_FinalChecker" targetRef="_GW_Merge6">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "ReturnToSender".equals(finalCheckerDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_SF_S8_GW_Director" sourceRef="_Screen8" targetRef="_GW_Director"/>
    <bpmn2:sequenceFlow id="_SF_GW_Director_Archive" name="Approved" sourceRef="_GW_Director" targetRef="_Archive">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "Approved".equals(directorDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_SF_GW_Director_Merge3" name="Return for Modifications" sourceRef="_GW_Director" targetRef="_GW_Merge3">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "ReturnToSender".equals(directorDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_SF_Archive_End" sourceRef="_Archive" targetRef="_End"/>

  </bpmn2:process>

