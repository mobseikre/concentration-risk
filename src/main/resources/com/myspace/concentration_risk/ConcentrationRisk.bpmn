      <bpmn2:outgoing>_SF_GW_Director_Archive</bpmn2:outgoing>
      <bpmn2:outgoing>_SF_GW_Director_Merge3</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <!-- ARCHIVE — RISK MANAGEMENT ARCHIVE (Script Task) -->
    <bpmn2:scriptTask id="_Archive" name="Archive Final Report" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Archive Final Report]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SF_GW_Director_Archive</bpmn2:incoming>
      <bpmn2:outgoing>_SF_Archive_End</bpmn2:outgoing>
      <bpmn2:script><![CDATA[
String reqType = (String) kcontext.getVariable("requirementType");
kcontext.setVariable("archiveRef", "CR-CONC-" + reqType.replace(" ", "_").toUpperCase() + "-" + System.currentTimeMillis());
kcontext.setVariable("reportStatus", "ARCHIVED");
System.out.println("Report archived: " + kcontext.getVariable("archiveRef"));
      ]]></bpmn2:script>
    </bpmn2:scriptTask>

