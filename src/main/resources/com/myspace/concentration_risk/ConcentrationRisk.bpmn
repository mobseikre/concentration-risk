<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.omg.org/bpmn20" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:bpsim="http://www.bpsim.org/schemas/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="_ConcentrationRiskDefs" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd http://www.jboss.org/drools drools.xsd http://www.bpsim.org/schemas/1.0 bpsim.xsd http://www.omg.org/spec/DD/20100524/DC DC.xsd http://www.omg.org/spec/DD/20100524/DI DI.xsd" exporter="jBPM Process Modeler" exporterVersion="2.0" targetNamespace="http://www.omg.org/bpmn20">

  <bpmn2:itemDefinition id="_requirementTypeItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_commercialLoansDocItem" structureRef="org.jbpm.document.Document"/>
  <bpmn2:itemDefinition id="_overdraftDocItem" structureRef="org.jbpm.document.Document"/>
  <bpmn2:itemDefinition id="_specialFinancingDocItem" structureRef="org.jbpm.document.Document"/>
  <bpmn2:itemDefinition id="_concentrationDataItem" structureRef="java.util.List"/>
  <bpmn2:itemDefinition id="_adjustedDataItem" structureRef="java.util.List"/>
  <bpmn2:itemDefinition id="_calculatedResultsItem" structureRef="com.myspace.concentration_risk.CalculatedResults"/>
  <bpmn2:itemDefinition id="_narrativeReportItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_checkerDecisionItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_checkerCommentItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_finalCheckerDecisionItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_finalCheckerCommentItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_directorDecisionItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_directorStatementItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_returnReasonItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_excelFilePathItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_archiveRefItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_reportStatusItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_regulatoryLimitItem" structureRef="Double"/>

  <bpmn2:process id="concentration_risk.ConcentrationRisk" drools:packageName="com.myspace.concentration_risk" drools:version="1.0" drools:adHoc="false" name="ConcentrationRisk" isExecutable="true" processType="Public">

    <!-- ═══════════════════════════════════════════
         PROCESS VARIABLES  (SRS V1.0 — Screens 1-8)
         ═══════════════════════════════════════════ -->
    <bpmn2:property id="requirementType" itemSubjectRef="_requirementTypeItem" name="requirementType"/>
    <bpmn2:property id="commercialLoansDoc" itemSubjectRef="_commercialLoansDocItem" name="commercialLoansDoc"/>
    <bpmn2:property id="overdraftDoc" itemSubjectRef="_overdraftDocItem" name="overdraftDoc"/>
    <bpmn2:property id="specialFinancingDoc" itemSubjectRef="_specialFinancingDocItem" name="specialFinancingDoc"/>
    <bpmn2:property id="concentrationData" itemSubjectRef="_concentrationDataItem" name="concentrationData"/>
    <bpmn2:property id="adjustedData" itemSubjectRef="_adjustedDataItem" name="adjustedData"/>
    <bpmn2:property id="calculatedResults" itemSubjectRef="_calculatedResultsItem" name="calculatedResults"/>
    <bpmn2:property id="narrativeReport" itemSubjectRef="_narrativeReportItem" name="narrativeReport"/>
    <bpmn2:property id="checkerDecision" itemSubjectRef="_checkerDecisionItem" name="checkerDecision"/>
    <bpmn2:property id="checkerComment" itemSubjectRef="_checkerCommentItem" name="checkerComment"/>
    <bpmn2:property id="finalCheckerDecision" itemSubjectRef="_finalCheckerDecisionItem" name="finalCheckerDecision"/>
    <bpmn2:property id="finalCheckerComment" itemSubjectRef="_finalCheckerCommentItem" name="finalCheckerComment"/>
    <bpmn2:property id="directorDecision" itemSubjectRef="_directorDecisionItem" name="directorDecision"/>
    <bpmn2:property id="directorStatement" itemSubjectRef="_directorStatementItem" name="directorStatement"/>
    <bpmn2:property id="returnReason" itemSubjectRef="_returnReasonItem" name="returnReason"/>
    <bpmn2:property id="excelFilePath" itemSubjectRef="_excelFilePathItem" name="excelFilePath"/>
    <bpmn2:property id="archiveRef" itemSubjectRef="_archiveRefItem" name="archiveRef"/>
    <bpmn2:property id="reportStatus" itemSubjectRef="_reportStatusItem" name="reportStatus"/>
    <bpmn2:property id="regulatoryLimit" itemSubjectRef="_regulatoryLimitItem" name="regulatoryLimit"/>

    <!-- ═══════════════════════════════════════════
         START EVENT
         ═══════════════════════════════════════════ -->
    <bpmn2:startEvent id="_StartEvent" name="Start">
      <bpmn2:outgoing>_SF_Start_S1</bpmn2:outgoing>
    </bpmn2:startEvent>

    <!-- ═══════════════════════════════════════════
         SCREEN 1 — REQUIREMENT SELECTION (Maker)
         SRS 5.1 / FR-1
         ═══════════════════════════════════════════ -->
    <bpmn2:userTask id="_Screen1" name="Screen 1 - Requirements Selection" drools:taskName="Screen1_RequirementSelection">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Screen 1 - Requirements Selection]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SF_Start_S1</bpmn2:incoming>
      <bpmn2:outgoing>_SF_S1_S2</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_Screen1_TaskNameInput" drools:dtype="Object" name="TaskName"/>
        <bpmn2:dataInput id="_Screen1_GroupIdInput" drools:dtype="Object" name="GroupId"/>
        <bpmn2:dataInput id="_Screen1_SkippableInput" drools:dtype="Object" name="Skippable"/>
        <bpmn2:dataInput id="_Screen1_FormNameInput" drools:dtype="Object" name="FormName"/>
        <bpmn2:dataOutput id="_Screen1_Out_requirementType" drools:dtype="String" name="requirementType"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_Screen1_TaskNameInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen1_GroupIdInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen1_SkippableInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen1_FormNameInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_Screen1_Out_requirementType</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_Screen1_TaskNameInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[Screen1_RequirementSelection]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_Screen1_TaskNameInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_Screen1_GroupIdInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[maker]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_Screen1_GroupIdInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_Screen1_SkippableInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[false]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_Screen1_SkippableInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_Screen1_FormNameInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[Screen1_RequirementSelection]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_Screen1_FormNameInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_Screen1_Out_requirementType</bpmn2:sourceRef>
        <bpmn2:targetRef>requirementType</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:potentialOwner>
        <bpmn2:resourceAssignmentExpression>
          <bpmn2:formalExpression>maker</bpmn2:formalExpression>
        </bpmn2:resourceAssignmentExpression>
      </bpmn2:potentialOwner>
    </bpmn2:userTask>

    <!-- ═══════════════════════════════════════════
         SCREEN 2 — DOCUMENTATION UPLOAD (Maker)
         SRS 5.2 / FR-2 — 3 Excel sheets
         ═══════════════════════════════════════════ -->
    <bpmn2:userTask id="_Screen2" name="Screen 2 - Documentation Upload" drools:taskName="Screen2_DocumentUpload">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Screen 2 - Documentation Upload]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SF_S1_S2</bpmn2:incoming>
      <bpmn2:outgoing>_SF_S2_Parse</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_Screen2_TaskNameInput" drools:dtype="Object" name="TaskName"/>
        <bpmn2:dataInput id="_Screen2_GroupIdInput" drools:dtype="Object" name="GroupId"/>
        <bpmn2:dataInput id="_Screen2_SkippableInput" drools:dtype="Object" name="Skippable"/>
        <bpmn2:dataInput id="_Screen2_FormNameInput" drools:dtype="Object" name="FormName"/>
        <bpmn2:dataInput id="_Screen2_In_requirementType" drools:dtype="String" name="requirementType"/>
        <bpmn2:dataOutput id="_Screen2_Out_commercialLoansDoc" drools:dtype="org.jbpm.document.Document" name="commercialLoansDoc"/>
        <bpmn2:dataOutput id="_Screen2_Out_overdraftDoc" drools:dtype="org.jbpm.document.Document" name="overdraftDoc"/>
        <bpmn2:dataOutput id="_Screen2_Out_specialFinancingDoc" drools:dtype="org.jbpm.document.Document" name="specialFinancingDoc"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_Screen2_TaskNameInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen2_GroupIdInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen2_SkippableInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen2_FormNameInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen2_In_requirementType</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_Screen2_Out_commercialLoansDoc</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Screen2_Out_overdraftDoc</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Screen2_Out_specialFinancingDoc</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_Screen2_TaskNameInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[Screen2_DocumentUpload]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_Screen2_TaskNameInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_Screen2_GroupIdInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[maker]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_Screen2_GroupIdInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_Screen2_SkippableInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[false]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_Screen2_SkippableInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_Screen2_FormNameInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[Screen2_DocumentUpload]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_Screen2_FormNameInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>requirementType</bpmn2:sourceRef>
        <bpmn2:targetRef>_Screen2_In_requirementType</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_Screen2_Out_commercialLoansDoc</bpmn2:sourceRef>
        <bpmn2:targetRef>commercialLoansDoc</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_Screen2_Out_overdraftDoc</bpmn2:sourceRef>
        <bpmn2:targetRef>overdraftDoc</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_Screen2_Out_specialFinancingDoc</bpmn2:sourceRef>
        <bpmn2:targetRef>specialFinancingDoc</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:potentialOwner>
        <bpmn2:resourceAssignmentExpression>
          <bpmn2:formalExpression>maker</bpmn2:formalExpression>
        </bpmn2:resourceAssignmentExpression>
      </bpmn2:potentialOwner>
    </bpmn2:userTask>

    <!-- ═══════════════════════════════════════════
         PARSE DOCUMENTS — builds concentrationData rows
         from the uploaded Excel files (SRS 5.2 -> 5.3)
         ═══════════════════════════════════════════ -->
    <bpmn2:scriptTask id="_ParseDocs" name="Parse Uploaded Documents" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Parse Uploaded Documents]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SF_S2_Parse</bpmn2:incoming>
      <bpmn2:outgoing>_SF_Parse_Merge3</bpmn2:outgoing>
      <bpmn2:script><![CDATA[
// ═══ DOCUMENT PARSING (DEMO) ═══
// Real production logic reads the uploaded .xlsx files with Apache POI and
// extracts the rows from the official templates (القروض التجارية / السحب على المكشوف /
// بيان خاص بالتمويلات). This demo seeds representative rows per requirement type so
// the full workflow can be exercised end to end.

String reqType = (String) kcontext.getVariable("requirementType");
java.util.List rows = new java.util.ArrayList();

if ("Commercial loans".equals(reqType)) {
    com.myspace.concentration_risk.ConcentrationRow r = new com.myspace.concentration_risk.ConcentrationRow();
    r.setCompanyName("Al Wahda Steel Co"); r.setCompanyField("Industry"); r.setGeographicalConcentration("Tripoli");
    r.setValueGiven(185000000.0); r.setGivenDate(new java.util.Date()); r.setCreditType("Term Loan"); r.setBalanceDue(175000000.0);
    rows.add(r);
    r = new com.myspace.concentration_risk.ConcentrationRow();
    r.setCompanyName("Libya Services Ltd"); r.setCompanyField("Services"); r.setGeographicalConcentration("Benghazi");
    r.setValueGiven(120000000.0); r.setGivenDate(new java.util.Date()); r.setCreditType("Term Loan"); r.setBalanceDue(118000000.0);
    rows.add(r);
    r = new com.myspace.concentration_risk.ConcentrationRow();
    r.setCompanyName("Medina Trading"); r.setCompanyField("Trade"); r.setGeographicalConcentration("Misrata");
    r.setValueGiven(95000000.0); r.setGivenDate(new java.util.Date()); r.setCreditType("Revolving"); r.setBalanceDue(94000000.0);
    rows.add(r);
    r = new com.myspace.concentration_risk.ConcentrationRow();
    r.setCompanyName("Delta Construction"); r.setCompanyField("Construction"); r.setGeographicalConcentration("Tripoli");
    r.setValueGiven(82000000.0); r.setGivenDate(new java.util.Date()); r.setCreditType("Overdraft"); r.setBalanceDue(80000000.0);
    rows.add(r);
} else if ("Overdraft".equals(reqType)) {
    com.myspace.concentration_risk.ConcentrationRow r = new com.myspace.concentration_risk.ConcentrationRow();
    r.setCompanyName("Libya Services Ltd"); r.setCompanyField("Services"); r.setGeographicalConcentration("Benghazi");
    r.setValueGiven(75000000.0); r.setGivenDate(new java.util.Date()); r.setCreditType("Overdraft"); r.setBalanceDue(74000000.0);
    rows.add(r);
    r = new com.myspace.concentration_risk.ConcentrationRow();
    r.setCompanyName("Green Farm Co"); r.setCompanyField("Agriculture"); r.setGeographicalConcentration("Zawiya");
    r.setValueGiven(46000000.0); r.setGivenDate(new java.util.Date()); r.setCreditType("Overdraft"); r.setBalanceDue(45000000.0);
    rows.add(r);
    r = new com.myspace.concentration_risk.ConcentrationRow();
    r.setCompanyName("Fast Logistics"); r.setCompanyField("Transport"); r.setGeographicalConcentration("Tripoli");
    r.setValueGiven(33000000.0); r.setGivenDate(new java.util.Date()); r.setCreditType("Overdraft"); r.setBalanceDue(32000000.0);
    rows.add(r);
} else {
    com.myspace.concentration_risk.ConcentrationRow r = new com.myspace.concentration_risk.ConcentrationRow();
    r.setCompanyName("Gulf Textile Co"); r.setCompanyField("Industry"); r.setGeographicalConcentration("Benghazi");
    r.setValueGiven(64000000.0); r.setGivenDate(new java.util.Date()); r.setCreditType("Murabaha"); r.setBalanceDue(63000000.0);
    rows.add(r);
    r = new com.myspace.concentration_risk.ConcentrationRow();
    r.setCompanyName("Sahara Telecom"); r.setCompanyField("Telecom"); r.setGeographicalConcentration("Tripoli");
    r.setValueGiven(52000000.0); r.setGivenDate(new java.util.Date()); r.setCreditType("Ijara"); r.setBalanceDue(51000000.0);
    rows.add(r);
    r = new com.myspace.concentration_risk.ConcentrationRow();
    r.setCompanyName("Nile Food Co"); r.setCompanyField("Agriculture"); r.setGeographicalConcentration("Misrata");
    r.setValueGiven(38000000.0); r.setGivenDate(new java.util.Date()); r.setCreditType("Musharaka"); r.setBalanceDue(37000000.0);
    rows.add(r);
}

kcontext.setVariable("concentrationData", rows);
kcontext.setVariable("adjustedData", rows);
System.out.println("Parsed " + rows.size() + " concentration rows for: " + reqType);
      ]]></bpmn2:script>
    </bpmn2:scriptTask>

    <!-- ═══════════════════════════════════════════
         SCREEN 3 — DATA ADJUSTMENT AND ROW MANAGEMENT (Maker)
         SRS 5.3 / FR-3 — edit base values, hide rows
         ═══════════════════════════════════════════ -->
    <bpmn2:userTask id="_Screen3" name="Screen 3 - Data Adjustment and Review" drools:taskName="Screen3_AdjustmentReview">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Screen 3 - Data Adjustment and Review]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SF_Merge3_S3</bpmn2:incoming>
      <bpmn2:outgoing>_SF_S3_S4</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_Screen3_TaskNameInput" drools:dtype="Object" name="TaskName"/>
        <bpmn2:dataInput id="_Screen3_GroupIdInput" drools:dtype="Object" name="GroupId"/>
        <bpmn2:dataInput id="_Screen3_SkippableInput" drools:dtype="Object" name="Skippable"/>
        <bpmn2:dataInput id="_Screen3_FormNameInput" drools:dtype="Object" name="FormName"/>
        <bpmn2:dataInput id="_Screen3_In_concentrationData" drools:dtype="java.util.List" name="concentrationData"/>
        <bpmn2:dataInput id="_Screen3_In_checkerComment" drools:dtype="String" name="checkerComment"/>
        <bpmn2:dataInput id="_Screen3_In_finalCheckerComment" drools:dtype="String" name="finalCheckerComment"/>
        <bpmn2:dataInput id="_Screen3_In_returnReason" drools:dtype="String" name="returnReason"/>
        <bpmn2:dataOutput id="_Screen3_Out_adjustedData" drools:dtype="java.util.List" name="adjustedData"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_Screen3_TaskNameInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen3_GroupIdInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen3_SkippableInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen3_FormNameInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen3_In_concentrationData</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen3_In_checkerComment</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen3_In_finalCheckerComment</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Screen3_In_returnReason</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_Screen3_Out_adjustedData</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_Screen3_TaskNameInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[Screen3_AdjustmentReview]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_Screen3_TaskNameInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_Screen3_GroupIdInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[maker]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_Screen3_GroupIdInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_Screen3_SkippableInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[false]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_Screen3_SkippableInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
